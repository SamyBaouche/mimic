# Everything here is optional: Mimic works with no .env at all.

# Storage. Empty = SQLite file in MIMIC_HOME (default ~/.mimic/mimic.db).
# Postgres + pgvector (pip install "mimic-agent[postgres]", docker compose up -d):
# DATABASE_URL=postgresql://mimic:mimic@localhost:5432/mimic
DATABASE_URL=
# MIMIC_HOME=~/.mimic

# Local models (Ollama)
OLLAMA_HOST=http://localhost:11434
VISION_MODEL=qwen2.5vl:7b
PLANNER_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text

SANDBOX_URL=http://localhost:8001

# Secrets typed by a skill (passwords...) are never stored. Give them per session:
# MIMIC_SECRET_PASSWORD=...
